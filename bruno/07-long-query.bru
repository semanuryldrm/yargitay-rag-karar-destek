meta {
  name: Uzun Sorgu Sınır Testi
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/semantic-search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const seed = "İş sözleşmesinin geçerli neden gösterilmeden feshedildiği ve işe iade koşullarının değerlendirildiği olay. ";
  let longEvent = seed.repeat(Math.ceil(4000 / seed.length)).slice(0, 4000);
  if (/\s/.test(longEvent.slice(-1))) {
    longEvent = `${longEvent.slice(0, -1)}.`;
  }
  bru.setVar("longEvent", longEvent);
}

body:json {
  {
    "olay": "{{longEvent}}",
    "top_k": 3,
    "min_score": 0.65
  }
}

tests {
  test("4.000 karakterlik geçerli sorgu kabul edilir", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().sorgu).to.have.lengthOf(4000);
  });

  test("Arama sınırlandırılmış ve kaynaklıdır", function() {
    const body = res.getBody();
    expect(body.sonuc_sayisi).to.be.at.most(3);
    expect(body.embedding_modeli).to.equal("text-embedding-embeddinggemma-300m");
    expect(body.koleksiyon).to.equal("yargitay_karar_parcalari");
  });
}
