meta {
  name: Sistem Sağlığı
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/system-status
  body: none
  auth: none
}

tests {
  test("HTTP 200 döner", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("31.544 chunk hazırdır", function() {
    expect(res.getBody().indexed_chunks).to.equal(31544);
  });

  test("Servis durumu ok değeridir", function() {
    expect(res.getBody().status).to.equal("ok");
  });

  test("Embedding, Qdrant ve Gemma bileşenleri hazırdır", function() {
    const components = res.getBody().components;
    expect(components.embedding.status).to.equal("ok");
    expect(components.vector_database.status).to.equal("ok");
    expect(components.vector_database.indexed_chunks).to.equal(31544);
    expect(components.gemma.status).to.equal("ok");
  });
}
